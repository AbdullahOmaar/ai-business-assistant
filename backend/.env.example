# Local development only. Replace with credentials for your own local PostgreSQL.
# Never put real secrets in Git or commit a populated .env file.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ai_business_assistant

# Production identity verification (Firebase Authentication)
FIREBASE_PROJECT_ID=
# Prefer workload identity where available; otherwise provide the service account JSON as a secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated exact frontend origins; do not use '*' with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# AI chat stays disabled until an API key is configured on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
